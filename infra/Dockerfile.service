# Build Stage
FROM debian:bookworm-slim AS builder
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    libprotobuf-dev \
    libgrpc++-dev \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Build libpqxx 7.7 from source to generate the CMake config files your project expects
WORKDIR /tmp
RUN git clone --branch 7.7.5 https://github.com/jtv/libpqxx.git && \
    cd libpqxx && \
    mkdir build && cd build && \
    cmake .. -DBUILD_SHARED_LIBS=OFF -DSKIP_BUILD_TEST=ON && \
    cmake --build . --parallel 4 && \
    cmake --install .

WORKDIR /app
COPY . .

# Clean local artifacts and compile release binary
RUN rm -rf build && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    cmake --build . --parallel 4

# Runtime Stage
FROM debian:bookworm-slim
# We no longer need libpqxx here because it is statically linked into your binary!
RUN apt-get update && apt-get install -y \
    libpq5 \
    libprotobuf32 \
    libgrpc++1.51 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG SERVICE_NAME
COPY --from=builder /app/build/${SERVICE_NAME} /app/service_binary

ENTRYPOINT ["/app/service_binary"]